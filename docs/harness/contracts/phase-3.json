{
  "schema_version": "1.0",
  "core_version": "1.0",
  "contract_id": "contract:local-llm:phase-3",
  "task_id": "PHASE-3",
  "contract_version": 1,
  "status": "active",
  "contract_hash": "sha256:281acc7df27b16bbd694104b4df1a3af02b3a1c33c362123e3f7a858f30da4d8",
  "objective": "docs/ と ai_harness の Markdown を根拠に答える RAG を実装し、Web UI と CLI から「資料を使う」モードで根拠付き回答が得られる状態にする(docs/spec-phase3-6.md 2 章)",
  "expected_outcomes": [
    "uv run llm-index で文書がチャンク化・ベクトル化され SQLite に入る(差分更新)",
    "use_rag=true の応答に sources イベントと [n] 引用が含まれる",
    "既知の質問 10 件で正解文書が top-3 に 8/10 以上入る",
    "Phase 1/2 のテストがすべて通る",
    "docs/journal/phase-3.md と Completion Report がある"
  ],
  "scope": {
    "read": [
      "**"
    ],
    "write": [
      "src/local_llm/**",
      "tests/**",
      "scripts/fetch-corpus.ps1",
      "scripts/agent/**",
      "models.ini",
      "pyproject.toml",
      "uv.lock",
      "README.md",
      "docs/**",
      "data/corpus/**",
      ".gitignore"
    ],
    "forbidden": [
      ".env",
      "llama-local/**",
      "**/*.gguf",
      "data/chat.db",
      ".git/**"
    ],
    "destinations": [
      "127.0.0.1",
      "raw.githubusercontent.com (ai_harness の Markdown 取得のみ)",
      "huggingface.co (llama-server によるモデル取得のみ)"
    ]
  },
  "non_goals": [
    "ベクトル DB(Chroma, Qdrant など)の導入",
    "PDF の取り込み",
    "Web UI からの文書アップロード",
    "リランカーモデルの導入(簡易な再スコアリングは可)",
    "Phase 4 以降の機能"
  ],
  "constraints": [
    {
      "constraint_id": "NO_PUSH",
      "statement": "git push、GitHub の公開設定変更、Hugging Face へのアップロードなど外部送信を行わない(Human Gate)",
      "required": true
    },
    {
      "constraint_id": "NO_SECRETS",
      "statement": "API キーや個人情報をコード・ログ・ドキュメントに書かない",
      "required": true
    },
    {
      "constraint_id": "JOURNAL",
      "statement": "docs/journal/phase-N.md を実装と同時に書き、判断の理由と確かめ方を残す",
      "required": true
    },
    {
      "constraint_id": "REPORT",
      "statement": "完了時に docs/harness/reports/phase-N.md と phase-N.decision.json を書き、criterion ごとに証拠(コマンド出力の要点とコミット hash)を付ける",
      "required": true
    },
    {
      "constraint_id": "AMEND_NOT_EXPAND",
      "statement": "scope 外の変更が必要になったら作業を止め、Report に Amendment 案を書く。黙って範囲を広げない",
      "required": true
    },
    {
      "constraint_id": "CLIENT_ONLY_HTTP",
      "statement": "llama-server への HTTP は LlamaClient 経由のみ(internal-spec 3 章の原則を維持)",
      "required": true
    },
    {
      "constraint_id": "EMBED_IN_INI",
      "statement": "埋め込みモデルは models.ini に追加する。既存セクションは変更しない",
      "required": true
    }
  ],
  "completion_criteria": [
    {
      "criterion_id": "RAG-001",
      "assertion": "uv run llm-index docs README.md で documents/chunks が DB に入り、再実行で未変更ファイルがスキップされる",
      "required": true,
      "verification_methods": [
        "integration-test"
      ]
    },
    {
      "criterion_id": "RAG-002",
      "assertion": "tests/rag/eval_retrieval.jsonl の質問 10 件で正解文書が top-3 に 8 件以上入る(実サーバ、結果を Report に記録)",
      "required": true,
      "verification_methods": [
        "e2e"
      ]
    },
    {
      "criterion_id": "RAG-003",
      "assertion": "use_rag=true の応答で sources イベントが本文の前に届き、本文に [n] 引用が含まれる",
      "required": true,
      "verification_methods": [
        "integration-test",
        "e2e"
      ]
    },
    {
      "criterion_id": "RAG-004",
      "assertion": "既存テスト(Phase 1/2)を含め uv run pytest がすべて通る",
      "required": true,
      "verification_methods": [
        "unit-test"
      ]
    },
    {
      "criterion_id": "RAG-005",
      "assertion": "docs/journal/phase-3.md がテンプレートの全節を満たし、external-spec / internal-spec に RAG の節が追加されている",
      "required": true,
      "verification_methods": [
        "diff-review",
        "human-review"
      ]
    }
  ],
  "required_evidence": [
    {
      "requirement_id": "EV-RAG-TESTS",
      "criterion_ids": [
        "RAG-001",
        "RAG-003",
        "RAG-004"
      ],
      "evidence_type": "pytest 出力(verify.ps1)",
      "minimum_independence": "deterministic-process",
