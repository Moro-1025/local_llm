  "objective": "WSL Ubuntu + unsloth で Qwen3 小型モデルに QLoRA を行い、docs/ と ai_harness から合成した Q&A で学習し、GGUF に変換して models.ini に登録、llama-server から会話できる状態にする(docs/spec-phase3-6.md 4 章)",
  "expected_outcomes": [
    "training/setup-wsl.sh で WSL に環境が作れ torch.cuda.is_available() が True",
    "training/data/qa.jsonl が 300 組以上、qa.meta.json に合成条件がある",
    "学習が完走し eval loss が下がっている(ログ保存)",
    "GGUF が models.ini に登録され CLI から 1 往復できる",
    "docs/journal/phase-5.md と Completion Report がある"
  ],
  "scope": {
    "read": [
      "**"
    ],
    "write": [
      "training/**",
      "models.ini",
      "eval/datasets/**",
      "README.md",
      "docs/**",
      ".gitignore",
      "scripts/agent/**"
    ],
    "forbidden": [
      ".env",
      "llama-local/**",
      "**/*.gguf",
      "data/chat.db",
      ".git/**"
    ],
    "destinations": [
      "127.0.0.1",
      "huggingface.co (ベースモデルのダウンロードのみ)",
      "pypi.org / download.pytorch.org (WSL 環境の構築のみ)"
    ]
  },
  "non_goals": [
    "フルファインチューニング",
    "4B より大きいモデルの学習",
    "Hugging Face へのアップロード(人間が行う)",
    "src/local_llm/ の変更(Phase 3/4 のブランチと衝突するため)"
  ],
  "constraints": [
    {
      "constraint_id": "NO_PUSH",
      "statement": "git push、GitHub の公開設定変更、Hugging Face へのアップロードなど外部送信を行わない(Human Gate)",
      "required": true
    },
    {
      "constraint_id": "NO_SECRETS",
      "statement": "API キーや個人情報をコード・ログ・ドキュメントに書かない",
      "required": true
    },
    {
      "constraint_id": "JOURNAL",
      "statement": "docs/journal/phase-N.md を実装と同時に書き、判断の理由と確かめ方を残す",
      "required": true
    },
    {
      "constraint_id": "REPORT",
      "statement": "完了時に docs/harness/reports/phase-N.md と phase-N.decision.json を書き、criterion ごとに証拠(コマンド出力の要点とコミット hash)を付ける",
      "required": true
    },
    {
      "constraint_id": "AMEND_NOT_EXPAND",
      "statement": "scope 外の変更が必要になったら作業を止め、Report に Amendment 案を書く。黙って範囲を広げない",
      "required": true
    },
    {
      "constraint_id": "SEPARATE_ENV",
      "statement": "学習環境は training/ 配下の WSL 用 venv に閉じ、Windows 側の uv 環境(pyproject.toml)に torch 等を足さない",
      "required": true
    },
    {
      "constraint_id": "EVAL_SPLIT",
      "statement": "eval 用の質問は学習に使わず eval/datasets/qa-v1.jsonl に版番号付きで保存する(評価汚染の防止)",
      "required": true
    },
    {
      "constraint_id": "VRAM_GUARD",
      "statement": "学習前に VRAM を見積もり、12 GB を超える構成は試さない。OOM が 2 回出たら小さいモデルか短い系列長に切り替える",
      "required": true
    }
  ],
  "completion_criteria": [
    {
      "criterion_id": "LORA-001",
      "assertion": "WSL で training/setup-wsl.sh 実行後、python -c 'import torch;print(torch.cuda.is_available())' が True を出す",
      "required": true,
      "verification_methods": [
        "other"
      ]
    },
    {
      "criterion_id": "LORA-002",
      "assertion": "training/data/qa.jsonl が 300 組以上で、各行が question/answer/source を持ち、qa.meta.json にプロンプト・モデル id・日時がある",
      "required": true,
      "verification_methods": [
        "unit-test"
      ]
    },
    {
      "criterion_id": "LORA-003",
      "assertion": "学習ログ training/runs/<日時>/ に loss 推移があり、最終 eval loss が最初の eval loss より低い",
      "required": true,
      "verification_methods": [
        "other"
      ]
    },
    {
      "criterion_id": "LORA-004",
      "assertion": "変換した GGUF が models.ini に登録され、llama-server 経由で CLI から 1 往復できる",
      "required": true,
      "verification_methods": [
        "e2e"
      ]
    },
    {
      "criterion_id": "LORA-005",
      "assertion": "eval 質問 20 件で LoRA モデルの簡易正答率(キーワード一致)が素の同サイズモデルを上回る(暫定。Phase 6 で再評価)",
      "required": false,
      "verification_methods": [
        "e2e"
      ]
    },
    {
      "criterion_id": "LORA-006",
      "assertion": "docs/journal/phase-5.md がテンプレートの全節を満たし、VRAM 実測と選んだモデルの理由がある",
      "required": true,
      "verification_methods": [
        "diff-review",
        "human-review"
      ]
    }
  ],
