  "objective": "評価ハーネスを作り、5 構成(素の大型 / +RAG / 素の小型 / +LoRA / +LoRA+RAG)を同じデータセットで比較し、bench と ctx-vram を計測し、README を公開用に整える(docs/spec-phase3-6.md 5 章)。公開操作そのものは人間が行う",
  "expected_outcomes": [
    "uv run llm-eval --suite qa --config X で結果 JSON と Markdown が出る",
    "5 構成の結果が eval/results/ にあり README の比較表に転記されている",
    "採点モデルと回答モデルが別で、結果 JSON に記録されている",
    "bench / ctx-vram の表が README で埋まっている",
    "README に構成図・再現手順・各 Phase の成果・LICENSE がある",
    "docs/journal/phase-6.md と Completion Report がある"
  ],
  "scope": {
    "read": [
      "**"
    ],
    "write": [
      "src/local_llm/**",
      "tests/**",
      "eval/**",
      "bench/**",
      "scripts/**",
      "pyproject.toml",
      "uv.lock",
      "README.md",
      "LICENSE",
      "docs/**",
      "training/export/**",
      ".gitignore"
    ],
    "forbidden": [
      ".env",
      "llama-local/**",
      "**/*.gguf",
      "data/chat.db",
      ".git/**"
    ],
    "destinations": [
      "127.0.0.1"
    ]
  },
  "non_goals": [
    "新しいモデルの学習",
    "GitHub / Hugging Face への公開操作(人間が行う)",
    "評価データセットの事後的な差し替え(版を上げずに中身を変えること)"
  ],
  "constraints": [
    {
      "constraint_id": "NO_PUSH",
      "statement": "git push、GitHub の公開設定変更、Hugging Face へのアップロードなど外部送信を行わない(Human Gate)",
      "required": true
    },
    {
      "constraint_id": "NO_SECRETS",
      "statement": "API キーや個人情報をコード・ログ・ドキュメントに書かない",
      "required": true
    },
    {
      "constraint_id": "JOURNAL",
      "statement": "docs/journal/phase-N.md を実装と同時に書き、判断の理由と確かめ方を残す",
      "required": true
    },
    {
      "constraint_id": "REPORT",
      "statement": "完了時に docs/harness/reports/phase-N.md と phase-N.decision.json を書き、criterion ごとに証拠(コマンド出力の要点とコミット hash)を付ける",
      "required": true
    },
    {
      "constraint_id": "AMEND_NOT_EXPAND",
      "statement": "scope 外の変更が必要になったら作業を止め、Report に Amendment 案を書く。黙って範囲を広げない",
      "required": true
    },
    {
      "constraint_id": "GRADER_SEPARATION",
      "statement": "LLM 採点のモデルは回答モデルと別にする(同じモデルが自分を採点しない)",
      "required": true
    },
    {
      "constraint_id": "DATASET_VERSIONED",
      "statement": "評価データは eval/datasets/<name>-v<N>.jsonl とし、中身を変えるときは版を上げる",
      "required": true
    }
  ],
  "completion_criteria": [
    {
      "criterion_id": "EVAL-001",
      "assertion": "uv run llm-eval --suite qa --config A が eval/results/ に JSON と Markdown を生成する",
      "required": true,
      "verification_methods": [
        "integration-test",
        "e2e"
      ]
    },
    {
      "criterion_id": "EVAL-002",
      "assertion": "5 構成の結果ファイルがそろい、README の比較表の数値が結果 JSON と一致する",
      "required": true,
      "verification_methods": [
        "diff-review",
        "human-review"
      ]
    },
    {
      "criterion_id": "EVAL-003",
      "assertion": "結果 JSON の grader.model と answer.model が異なる(schema で検証)",
      "required": true,
      "verification_methods": [
        "schema"
      ]
    },
    {
      "criterion_id": "EVAL-004",
      "assertion": "README のベンチマーク表と ctx-size 表が bench/ の結果で埋まっている",
      "required": true,
      "verification_methods": [
        "diff-review"
      ]
    },
    {
      "criterion_id": "EVAL-005",
      "assertion": "README に構成図、再現手順、各 Phase の成果、LICENSE(MIT)がある",
      "required": true,
      "verification_methods": [
        "human-review"
      ]
    },
    {
      "criterion_id": "EVAL-006",
      "assertion": "docs/journal/phase-6.md がテンプレートの全節を満たし、評価の限界(件数、採点の主観性)が書かれている",
      "required": true,
      "verification_methods": [
        "diff-review",
        "human-review"
      ]
    }
  ],
