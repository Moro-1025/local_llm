{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moro1025:ai-harness:schema:policy-decision:1.0",
  "title": "AI Harness Policy Decision",
  "description": "Authorization decision for an exact subject, task contract, action, data flow, target version, and policy version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_version",
    "decision_id",
    "evaluation_status",
    "decision",
    "subject",
    "task",
    "resource",
    "operation",
    "data_flow",
    "target",
    "approval_refs",
    "policy",
    "input_hash",
    "reasons",
    "obligations",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "core_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "evaluation_status": {
      "enum": [
        "success",
        "failure"
      ]
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "require_approval"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type",
        "tenant",
        "roles"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_type": {
          "enum": [
            "human",
            "agent",
            "service",
            "ci",
            "worker"
          ]
        },
        "tenant": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "contract_id",
        "contract_version",
        "contract_hash",
        "risk_band"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contract_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "contract_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "risk_band": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_id",
        "tenant"
      ],
      "properties": {
        "resource_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "tenant": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown"
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "side_effect",
        "normalized_arguments_hash"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "side_effect": {
          "enum": [
            "none",
            "reversible",
            "conditionally-reversible",
            "irreversible"
          ]
        },
        "normalized_arguments_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tool_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "data_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_classifications",
        "derived_classification",
        "purpose",
        "destination"
      ],
      "properties": {
        "input_classifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted",
              "unknown"
            ]
          }
        },
        "derived_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "identifier",
            "tenant",
            "maximum_classification"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "identifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "tenant": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "maximum_classification": {
              "enum": [
                "public",
                "internal",
                "confidential",
                "restricted",
                "unknown"
              ]
            },
            "external": {
              "type": "boolean"
            }
          }
        },
        "redaction_evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version"
      ],
      "properties": {
        "expected_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "current_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "action_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "approval_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "source_refs"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "enum": [
              "human_approval",
              "redaction",
              "logging",
              "rate_limit",
              "subject_recheck",
              "destination_allowlist",
              "version_recheck",
              "idempotency",
              "trusted_verification",
              "other"
            ]
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_status": {
            "const": "failure"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "require_approval"
          }
        }
      },
      "then": {
        "properties": {
          "obligations": {
            "contains": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "human_approval"
                }
              },
              "required": [
                "type"
              ]
            }
          }
        }
      }
    }
  ]
}
