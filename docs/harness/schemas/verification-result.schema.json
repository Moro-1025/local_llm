{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moro1025:ai-harness:schema:verification-result:1.0",
  "title": "AI Harness Verification Result",
  "description": "Criterion-level verification result bound to a contract, subject version, verifier, and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_version",
    "result_id",
    "task_id",
    "contract_id",
    "contract_version",
    "contract_hash",
    "criterion_id",
    "assertion",
    "status",
    "verifier",
    "subject",
    "evidence_refs",
    "policy_decision_refs",
    "approval_refs",
    "limitations",
    "verified_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "core_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "criterion_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
    },
    "assertion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "not_run",
        "blocked",
        "waived"
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "version",
        "independent_from_writer"
      ],
      "properties": {
        "type": {
          "enum": [
            "schema",
            "static-analysis",
            "unit-test",
            "integration-test",
            "contract-test",
            "e2e",
            "policy",
            "query",
            "diff-review",
            "visual-review",
            "llm-review",
            "human-review",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "execution_identity": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "independent_from_writer": {
          "type": "boolean"
        },
        "environment_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "repository",
            "artifact",
            "resource",
            "action",
            "response",
            "dataset"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{7,64}$"
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "artifact_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "resource_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "action_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "dataset_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "anyOf": [
        {
          "required": [
            "commit"
          ],
          "properties": {
            "commit": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "artifact_hash"
          ],
          "properties": {
            "artifact_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        {
          "required": [
            "resource_version"
          ],
          "properties": {
            "resource_version": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "action_hash"
          ],
          "properties": {
            "action_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        {
          "required": [
            "dataset_version"
          ],
          "properties": {
            "dataset_version": {
              "type": "string"
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "policy_decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "approval_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "waiver": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "approval_ref",
        "reason",
        "expires_at",
        "residual_risk"
      ],
      "properties": {
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "residual_risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_run",
              "blocked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "waived"
          }
        }
      },
      "then": {
        "required": [
          "waiver"
        ],
        "properties": {
          "waiver": {
            "type": "object"
          },
          "approval_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
