{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moro1025:ai-harness:schema:approval-record:1.0",
  "title": "AI Harness Approval Record",
  "description": "Trusted approval bound to an exact contract, normalized action, subject version, policy decision, and expiration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_version",
    "approval_id",
    "task_id",
    "contract_id",
    "contract_version",
    "contract_hash",
    "action",
    "target",
    "trusted_view",
    "policy_decision_ref",
    "policy_version",
    "required_approvals",
    "separation_of_duties",
    "approvers",
    "status",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "core_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_hash",
        "tool_name",
        "normalized_arguments",
        "normalized_arguments_hash",
        "side_effect",
        "irreversible"
      ],
      "properties": {
        "action_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "normalized_arguments": {
          "type": "object"
        },
        "normalized_arguments_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "side_effect": {
          "enum": [
            "none",
            "reversible",
            "conditionally-reversible",
            "irreversible"
          ]
        },
        "irreversible": {
          "type": "boolean"
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "target_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "expected_version"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expected_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "actual_diff_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "artifact_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "trusted_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_by",
        "source_refs",
        "rendered_fields",
        "summary_hash",
        "rollback_or_compensation"
      ],
      "properties": {
        "generated_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "rendered_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summary_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "rollback_or_compensation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "residual_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "policy_decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "required_approvals": {
      "type": "integer",
      "minimum": 1
    },
    "separation_of_duties": {
      "type": "boolean"
    },
    "approvers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approver_id",
          "role",
          "decision",
          "decided_at"
        ],
        "properties": {
          "approver_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "decision": {
            "enum": [
              "approve",
              "reject"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "authentication_context_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          }
        }
      }
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "revoked",
        "consumed"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "consumed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "execution_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "break_glass": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "used",
        "reason",
        "review_due_at"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "review_due_at": {
          "type": "string",
          "format": "date-time"
        },
        "incident_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "approvers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "consumed"
          }
        }
      },
      "then": {
        "required": [
          "consumed_at",
          "execution_ref"
        ],
        "properties": {
          "consumed_at": {
            "type": "string"
          },
          "execution_ref": {
            "type": "string"
          }
        }
      }
    }
  ]
}
