{
  "schema_version": "1.0",
  "core_version": "1.0",
  "contract_id": "contract:local-llm:agent:summarize-docs",
  "task_id": "AGENT-SUMMARIZE-DOCS",
  "contract_version": 1,
  "status": "active",
  "contract_hash": "sha256:6519657f7e58b9bcfcff4effcb54cd5b73e56b01f6408ce27a40a3dc516f1371",
  "objective": "docs/ と data/corpus/ の文書を読み、指定テーマの要約と根拠ファイルを finish(summary, sources) で返す読み取り専用タスク",
  "expected_outcomes": [
    "finish が 1 回呼ばれ、summary(本文)と sources(根拠ファイルのパス)が evidence/<run_id>/result.json に残る",
    "sources はすべて scope.read 内に実在するファイル",
    "許可外ツールの実行、scope 外の読み取り、予算超過が無い"
  ],
  "scope": {
    "read": [
      "docs/**",
      "data/corpus/**",
      "README.md"
    ],
    "write": [],
    "forbidden": [
      ".env",
      "llama-local/**",
      "**/*.gguf",
      "data/chat.db",
      ".git/**",
      "agent/pi/auth.json"
    ],
    "destinations": [
      "127.0.0.1"
    ]
  },
  "non_goals": [
    "ファイルの作成・変更・削除",
    "シェルコマンドの実行",
    "外部ネットワークへのアクセス"
  ],
  "constraints": [
    {
      "constraint_id": "READ_ONLY",
      "statement": "書き込み・実行系のツールは使わない。許可は rag_search / read_file / list_files / finish のみ",
      "required": true
    },
    {
      "constraint_id": "NO_SELF_REPORT",
      "statement": "finish の本文は採用判定の根拠にしない。runner が criterion ごとに検証する",
      "required": true
    }
  ],
  "completion_criteria": [
    {
      "criterion_id": "FINISH_CALLED",
      "assertion": "finish ツールが呼ばれ、evidence/<run_id>/result.json が存在する",
      "required": true,
      "verification_methods": [
        "integration-test"
      ]
    },
    {
      "criterion_id": "SUMMARY_NONEMPTY",
      "assertion": "result.summary が空でない",
      "required": true,
      "verification_methods": [
        "integration-test"
      ]
    },
    {
      "criterion_id": "SOURCES_IN_SCOPE",
      "assertion": "result.sources が 1 件以上あり、すべて scope.read 内に実在するファイル(workspace または data/corpus/ からの相対)",
      "required": true,
      "verification_methods": [
        "integration-test"
      ]
    },
    {
      "criterion_id": "ONLY_ALLOWED_TOOLS",
      "assertion": "実行されたツールはすべて capability_profile.allowed_tools 内(許可外は block される)",
      "required": true,
      "verification_methods": [
        "policy",
        "integration-test"
      ]
    },
    {
      "criterion_id": "NO_SCOPE_VIOLATION",
      "assertion": "scope.read 外・forbidden のパスへのアクセスが無い(block scope_boundary_exceeded が 0 件)",
      "required": true,
      "verification_methods": [
        "policy",
        "integration-test"
      ]
    },
    {
      "criterion_id": "WITHIN_BUDGET",
      "assertion": "execution_budget 内で終了し、stop_reason が無い",
      "required": true,
      "verification_methods": [
        "integration-test"
      ]
    },
    {
      "criterion_id": "RUN_SETTLED",
      "assertion": "pi から agent_settled を受信し、runner にエラーが無い",
      "required": true,
      "verification_methods": [
        "integration-test"
      ]
    },
    {
      "criterion_id": "SUMMARY_QUALITY",
      "assertion": "summary が指定テーマに沿っていて、sources の内容と矛盾しない",
      "required": false,
      "verification_methods": [
        "human-review"
      ]
    }
  ],
  "required_evidence": [
    {
      "requirement_id": "EV-EVENTS",
      "criterion_ids": [
        "FINISH_CALLED",
        "ONLY_ALLOWED_TOOLS",
        "NO_SCOPE_VIOLATION",
        "WITHIN_BUDGET"
      ],
      "evidence_type": "evidence/<run_id>/events.jsonl",
      "minimum_independence": "deterministic-process",
      "tamper_resistance": "workspace"
    },
    {
      "requirement_id": "EV-RESULT",
      "criterion_ids": [
        "SUMMARY_NONEMPTY",
        "SOURCES_IN_SCOPE"
      ],
      "evidence_type": "evidence/<run_id>/result.json",
      "minimum_independence": "deterministic-process",
      "tamper_resistance": "workspace"
    },
    {
      "requirement_id": "EV-PI",
      "criterion_ids": [
        "RUN_SETTLED"
      ],
      "evidence_type": "evidence/<run_id>/pi_events.jsonl",
      "minimum_independence": "deterministic-process",
      "tamper_resistance": "workspace"
    }
  ],
  "risk_assessment": {
    "confidentiality": "low",
    "integrity": "not_applicable",
    "availability": "low",
    "external_side_effect": "not_applicable",
    "reversibility": "not_applicable",
    "financial_legal_impact": "not_applicable",
    "credential_access": "not_applicable",
    "tenant_boundary": "not_applicable",
    "detection_difficulty": "low",
    "recovery_time": "not_applicable",
    "rationale": [
      "読み取り専用。書き込み・実行ツールは allowed_tools に無く、extension が tool_call を block する",
      "ネットワークは 127.0.0.1 の llama-server と llm-web のみ"
    ],
    "data_classifications": [
      "public",
      "internal"
    ]
  },
  "risk_band": "low",
  "capability_profile": {
    "profile_id": "agent-read-only",
    "filesystem": "read",
    "network": {
      "mode": "allowlisted",
      "allowed_destinations": [
        "127.0.0.1"
      ]
    },
    "external_side_effects": "denied",
    "credential_access": "none",
    "allowed_tools": [
      "rag_search",
      "read_file",
      "list_files",
      "finish"
    ],
    "denied_tools": [
      "bash",
      "powershell",
      "write",
      "edit",
      "read",
      "grep",
      "find",
      "ls"
    ],
    "allowed_data_classifications": [
      "public",
      "internal"
    ],
    "purpose": "文書の要約"
  },
  "human_gates": [],
  "execution_budget": {
    "max_steps": 12,
    "max_tool_calls": 20,
    "max_wall_time_seconds": 900,
    "same_action_limit": 3,
    "same_error_limit": 2,
    "no_progress_limit": null,
    "max_files_changed": 0,
    "on_exceed": "stop"
  },
  "stop_conditions": [
    "scope_violation",
    "same_error_repeated_twice",
    "budget_exceeded"
  ],
