# このファイルを .env にコピーして使う(.env は git 管理外)
# 値を省略した項目は src/local_llm/config.py の既定値が使われる

# llama-server の URL
LLAMA_BASE_URL=http://127.0.0.1:8080

# 既定で使うモデル(llama-server の /v1/models が返す id。models.ini の "UD-" は落ちて公開される)
LLM_DEFAULT_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M

# Web UI の会話を保存する SQLite ファイル
CHAT_DB_PATH=data/chat.db

# llama-server への HTTP タイムアウト(秒)。大きいモデルの初回ロードに備えて長めにしている
LLAMA_TIMEOUT=600
